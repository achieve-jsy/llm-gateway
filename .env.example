# ===========================================
# LLM Gateway - 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ===========================================

# ---------- Gateway 服务 ----------
GATEWAY_PORT=8080

# ---------- Control Plane 服务 ----------
CONTROL_PLANE_PORT=8081
CONTROL_PLANE_URL=http://localhost:8081
INTERNAL_TOKEN=CHANGE_ME_INTERNAL_TOKEN

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=llm_gateway
DB_SSLMODE=disable
# 或直接指定 DSN（优先级高于上面的分项配置）:
# DATABASE_URL=host=localhost port=5432 user=postgres password=postgres dbname=llm_gateway sslmode=disable

# ---------- Redis ----------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- OpenTelemetry (可选) ----------
OTLP_ENABLED=false
OTLP_ENDPOINT=localhost:4317

# ---------- Provider API Keys (环境变量直连模式，不走 control-plane 时使用) ----------
# BAILIAN_API_KEY=sk-xxx
# BAILIAN_MODELS=qwen-turbo,qwen-plus
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner
# LITELLM_ENDPOINT=http://localhost:4000
# LITELLM_API_KEY=
# LITELLM_MODELS=
