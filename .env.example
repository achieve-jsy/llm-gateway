# ─── SSO / OAuth2 配置 (大群 OIDC) ───────────────────────────────────────────
# OIDC Provider URL（大群 OAuth 服务地址）
OAUTH_ISSUER_URL=https://oauth.example.net

# 应用申请后获得的 Client ID 和 Secret
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret

# OAuth 回调地址（必须 https，必须带 path，不能包含 #）
# 需与大群应用申请时填写的回调地址完全一致
OAUTH_REDIRECT_URI=https://your-domain.com/auth/callback

# 请求的权限范围（空格分隔）
OAUTH_SCOPES=openid profile email

# 本服务签发 JWT 的密钥（生产环境请使用强随机字符串）
JWT_SECRET=change-me-in-production

# 前端地址（OAuth 回调后重定向目标）
FRONTEND_URL=https://your-domain.com

# ─── 数据库 ──────────────────────────────────────────────────────────────────
# 方式一：完整 DSN（优先级高）
DATABASE_URL=host=192.0.2.10 port=5432 user=llm_gateway password=CHANGE_ME_PASSWORD dbname=llm_gateway sslmode=disable
# 方式二：分项配置（DATABASE_URL 为空时生效）
DB_HOST=192.0.2.10
DB_PORT=5432
DB_USER=llm_gateway
DB_PASSWORD=CHANGE_ME_PASSWORD
DB_NAME=llm_gateway
DB_SSLMODE=disable

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_ADDR=192.0.2.10:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
OBSERVABILITY_SPOOL_CAPACITY=100000
OBSERVABILITY_SPOOL_HIGH_WATERMARK=80000
OBSERVABILITY_SPOOL_CLAIM_MIN_IDLE=30s
OBSERVABILITY_BILLABLE_RESERVATION_TTL=10m

# ── 调用链正文直写 /datalog（计划 2/4；规格 docs/superpowers/specs/2026-09-23-trace-body-direct-write-design.md）──
# 留空 = 功能关闭，正文仍写进 call_traces 的 jsonb 列（默认值，安全）。
# 开启必须与 /datalog 的 bind mount 同时生效，否则所有正文会退化为 body_missing。
# TRACE_BODY_ROOT=/datalog/trace-archive-v4   # 必须绝对路径、不得是 /；留空或全空白 = 功能关闭
# TRACE_BODY_INST=blue                 # 只能是 blue / green，由部署脚本按当前环境注入
# TRACE_BODY_BLOCK_MB=1536             # 块大小阈值（规格 §5.3.3）
# TRACE_BODY_FLUSH_INTERVAL=1m         # 周期 flush（规格 §7.1：必须 ≤1m 且远小于滚动间隔）
# TRACE_BODY_ROLL_INTERVAL=1h          # 滚动间隔（规格 §15.1 R8：≤1h 且严格小于 minAge 3h）
#                                      # 键名注意：**不是**规格 §11.1 的 TRACE_BODY_SEAL_INTERVAL（登记 D50 / 交接 H3）
# TRACE_BODY_DISK_WATERMARK_PERCENT=90 # 磁盘水位（本计划新增，登记 D45）

# ─── 服务端口 ─────────────────────────────────────────────────────────────────
CONTROL_PLANE_PORT=8081
GATEWAY_PORT=8080

# ─── control-plane 本机观测端点（pprof + /metrics）────────────────────────────
# 仅监听本机，刻意不挂到对外 8081 路由（nginx 会把 8081 暴露到外网）。
# 蓝绿两色同时以 host 网络运行，故 compose 中两色使用不同端口（blue 9091 / green 9092）。
CONTROL_PLANE_ADMIN_ADDR=127.0.0.1:9091
# 设为 false/0/off/no 可整体关闭
CONTROL_PLANE_ADMIN_ENABLED=true
# 仅当确需从非回环地址访问时才设为 true（默认强制收敛到 127.0.0.1）
CONTROL_PLANE_ADMIN_ALLOW_NON_LOOPBACK=false

# ─── Catalog 同步（可选）────────────────────────────────────────────────────
# 默认远程源：raw.githubusercontent.com/BerriAI/litellm/main/...
# 内网部署无法访问 GitHub 时，将此变量指向内网镜像或代理地址。
# 留空则使用默认 GitHub URL；若内网无镜像，数据将自动 fallback 到内置快照。
#
# 示例（私有 Nginx 镜像）：
# CATALOG_REMOTE_URL=http://192.0.2.10/litellm-catalog/model_prices_and_context_window.json
CATALOG_REMOTE_URL=

# Catalog 远程拉取超时（默认 15s）。内网镜像响应快可调短，比如 5s。
CATALOG_HTTP_TIMEOUT=15s
