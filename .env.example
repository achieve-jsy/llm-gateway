# ─── SSO / OAuth2 配置 (大群 OIDC) ───────────────────────────────────────────
# OIDC Provider URL（大群 OAuth 服务地址）
OAUTH_ISSUER_URL=https://oauth.example.net

# 应用申请后获得的 Client ID 和 Secret
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret

# OAuth 回调地址（必须 https，必须带 path，不能包含 #）
# 需与大群应用申请时填写的回调地址完全一致
OAUTH_REDIRECT_URI=https://your-domain.com/auth/callback

# 请求的权限范围（空格分隔）
OAUTH_SCOPES=openid profile email

# 本服务签发 JWT 的密钥（生产环境请使用强随机字符串）
JWT_SECRET=change-me-in-production

# 前端地址（OAuth 回调后重定向目标）
FRONTEND_URL=https://your-domain.com

# ─── EHR 组织结构同步 ────────────────────────────────────────────────────────
# EHR API 长期 token（必填，从大群接口中心获取）
EHR_API_TOKEN=

# EHR 接口基址（接口中心代理地址）
# 生产环境: https://open.example.com/open-apis/ehr-apic
# 测试环境: https://open.test.daqun.chat.com/open-apis/ehrapi
EHR_BASE_URL=https://open.example.com/open-apis/ehr-apic

# 是否启用定时同步（默认 true，设为 false 可关闭）
EHR_SYNC_ENABLED=true

# 各实体的同步间隔（Go duration 格式，或秒数整数）
EHR_CRON_ORG=30m
EHR_CRON_COMPANY=30m
EHR_CRON_DEPARTMENT=15m
EHR_CRON_EMPLOYEE=10m
EHR_CRON_RECONCILE=12h

# 分布式锁 TTL（默认 10m）
EHR_LOCK_TTL=10m

# ─── 数据库 ──────────────────────────────────────────────────────────────────
# 方式一：完整 DSN（优先级高）
DATABASE_URL=host=192.0.2.10 port=5432 user=llm_gateway password=CHANGE_ME_PASSWORD dbname=llm_gateway sslmode=disable
# 方式二：分项配置（DATABASE_URL 为空时生效）
DB_HOST=192.0.2.10
DB_PORT=5432
DB_USER=llm_gateway
DB_PASSWORD=CHANGE_ME_PASSWORD
DB_NAME=llm_gateway
DB_SSLMODE=disable

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_ADDR=192.0.2.10:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0

# ─── 服务端口 ─────────────────────────────────────────────────────────────────
CONTROL_PLANE_PORT=8081
GATEWAY_PORT=8080

# ─── Catalog 同步（可选）────────────────────────────────────────────────────
# 默认远程源：raw.githubusercontent.com/BerriAI/litellm/main/...
# 内网部署无法访问 GitHub 时，将此变量指向内网镜像或代理地址。
# 留空则使用默认 GitHub URL；若内网无镜像，数据将自动 fallback 到内置快照。
#
# 示例（私有 Nginx 镜像）：
# CATALOG_REMOTE_URL=http://192.0.2.10/litellm-catalog/model_prices_and_context_window.json
CATALOG_REMOTE_URL=

# Catalog 远程拉取超时（默认 15s）。内网镜像响应快可调短，比如 5s。
CATALOG_HTTP_TIMEOUT=15s
