      {
        "method": "GET",
        "path": "/api/v1/model-catalog/search",
        "auth": "admin",
        "handler": "CatalogHandler.Search",
        "request_fields_required": [],
        "request_fields_optional": [],
        "query_params": ["q", "provider", "mode", "limit"],
        "query_param_constraints": {
          "q":        "omitempty,max=200",
          "provider": "omitempty,max=100",
          "mode":     "omitempty,oneof=chat embedding image audio",
          "limit":    "omitempty,min=1,max=100,default=20"
        },
        "$comment_empty_result": "空结果不是错误：返回 {data: [], total: 0}。",
        "response_status": [200, 400, 401, 500],
        "response_envelope": "{ data: CatalogItem[], total: number }",
        "response_item_fields": [
