  "org_leaders": {
    "base_prefix": "/api/v1",
    "auth": "jwt Bearer <jwt>（adminGroup，平台管理员）",
    "purpose": "组织负责人多值列表：增量覆盖与保留（同步只追加/更新属性，永不删除；手动新增是唯一手动入口）",
    "routes": {
      "GET /admin/org/leaders": {
        "handler": "OrgLeaderHandler.List",
        "purpose": "全量返回负责人（百行量级），前端按 node_type+node_id 分组挂到组织树节点",
        "response_keys": ["data[].id", "data[].node_type(studio|dept)", "data[].node_id(studios.id/departments.id)", "data[].name", "data[].passport", "data[].employee_id", "data[].source(ehr|manual)"]
      },
      "POST /admin/org/leaders": {
        "handler": "OrgLeaderHandler.Add",
        "purpose": "手动加负责人：keyword 按花名册解析（employee_id/group_e_number 精确、person_name 唯一）；重复加同一人幂等",
        "request_keys": ["node_type(studio|dept)", "node_id(uuid)", "keyword(工号或姓名)"],
        "errors": {
          "400": "invalid_body / invalid_node_type / invalid_node_id",
          "404": "node_not_found / employee_not_found（花名册查无此人或重名）"
        },
        "response_keys": ["data.outcome(inserted|updated|unchanged)"]
      }
    }
  },
  "ai_app_hub": {
    "base_prefix": "/api/v1",
    "auth": "jwt Bearer <jwt>；scope=all 需 user_roles.role=admin，scope=studio/department 另允许该工作室负责人（passport）",
    "purpose": "EHR 组织树同步：全量 / 单工作室（工作室+子树）/ 单部门（单节点）",
    "routes": {
      "POST /admin/ai-app-hub/sync": {
        "handler": "AIAppHubSyncHandler.Sync",
        "request_body": {
          "scope": "all | department | studio",
          "id": "scope=department 用 department_id；scope=studio 用 ai_app_studios.id"
        },
        "success_status": 200,
        "success_fields": ["scope", "departments", "studios", "hidden", "deleted_studios", "duration_ms", "diff（老表投影差量：studios/departments/mappings 各自的 inserted/updated/deleted）"],
        "schedule": "控制面启动时按 AI_APP_HUB_SYNC_CRON（默认 0 3 * * *，空串=关闭）+ AI_APP_HUB_SYNC_TZ（默认 Asia/Shanghai）每天全量同步；scope=all 会把 EHR 里已撤销的 source=ehr 工作室 visible=false，manual/手工行不动",
        "error_statuses": {
          "400": ["invalid body", "invalid scope", "id is required"],
          "403": ["forbidden"],
          "404": ["scope not found"],
          "409": ["sync in progress"],
          "502": ["ehr unauthorized", "ehr upstream", "ehr empty result"]
        }
      },
      "GET /admin/ai-app-hub/sync-status": {
        "handler": "AIAppHubSyncHandler.Status",
        "auth": "jwt Bearer <jwt>；scope=all 权限（admin）",
        "purpose": "管理页同步卡片：上次同步结果 + 是否正在同步（刷新后按钮仍保持禁用）",
        "success_status": 200,
        "success_fields": ["last_sync_at", "status(success|failed|'')", "scope", "error", "departments", "employees", "unmapped_departments", "resigned_accounts_disabled", "diff", "running"],
        "error_statuses": {"403": ["forbidden"]}
      }
    },
    "status_keys": ["ai_app_hub.last_sync_at", "ai_app_hub.last_sync_status", "ai_app_hub.last_sync_scope", "ai_app_hub.last_sync_error", "ai_app_hub.last_sync_deleted_studios", "ai_app_hub.last_sync_departments", "ai_app_hub.last_sync_employees", "ai_app_hub.last_sync_unmapped_departments", "ai_app_hub.last_sync_resigned_accounts", "ai_app_hub.last_diff"]
  }
}
