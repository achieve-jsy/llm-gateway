{
  "$comment": "FE↔BE 接口契约（增量维护）。历史全量契约曾移除；本文件按功能模块逐步补回。",
  "quick_provider_onboard": {
    "base_prefix": "/api/v1",
    "auth": "admin Bearer <jwt>",
    "purpose": "同一供应商多个 Key 快速创建多个渠道，并为每个渠道添加输入的所有模型；用户无需逐个填写渠道名。",
    "routes": {
      "POST /providers/quick-onboard/preview": {
        "handler": "ProviderQuickOnboardHandler.Preview",
        "success_status": 200,
        "error_statuses": {
          "400": ["bad_request"],
          "401": ["unauthorized"],
          "500": ["internal_error"]
        },
        "response_fields": ["provider_count", "model_count", "matrix_count", "name_prefix", "providers", "warnings"]
      },
      "POST /providers/quick-onboard": {
        "handler": "ProviderQuickOnboardHandler.Create",
        "success_status": 201,
        "alternative_success_statuses": {
          "409": ["all_targets_failed_with_data"]
        },
        "error_statuses": {
          "400": ["bad_request"],
          "401": ["unauthorized"],
          "500": ["internal_error"]
        },
        "response_fields": ["provider_count", "succeeded_count", "failed_count", "model_count_per_provider", "matrix_count", "results"]
      }
    },
    "request_body_fields": [
      "provider", "provider_slug", "purpose", "name_prefix", "credentials", "models"
    ],
    "provider_fields": [
      "definition_id", "type", "endpoint", "weight", "priority", "test_model",
      "remark", "max_retries", "timeout", "tag"
    ],
    "credential_item_fields": ["credentials", "remark"],
    "model_item_fields": [
      "name", "model_type", "upstream_model_id", "description",
      "context_length", "max_output_tokens", "price_mode",
      "input_price", "output_price", "cache_read_price", "cache_write_price",
      "catalog_id", "weight", "enabled"
    ],
    "required_fields": ["provider.definition_id", "provider.endpoint", "credentials", "models"],
    "validation": {
      "credentials": "array, min=1；每项 credentials 为与单渠道 ProviderPayload.credentials 一致的 JSON 字符串",
      "models": "array, min=1；每个输入模型都会创建到每个新渠道下",
      "model_type": "可选；chat | embedding | embedding_vl | rerank | rerank_vl | video；未传时后端按模型名推断",
      "enabled": "可选 bool；缺省 true。继承源渠道禁用模型时应传 false，创建后保持禁用",
      "price_mode": "catalog | manual；manual 时 input_price 或 output_price 至少一个大于 0",
      "name_prefix": "可选；后端用于自动生成渠道名。未传时按 provider definition display_name/id 生成",
      "provider_name_generation": "后端生成唯一渠道名：<name_prefix-or-definition-id/purpose>-NNN；若与已有 providers.name 冲突应自动递增，分配失败返回 400 bad_request。"
    },
    "preview_provider_fields": ["index", "name", "credential", "models", "model_count", "remark", "will_create"],
    "create_result_item_fields": ["index", "name", "provider_id", "model_ids", "model_count", "status", "error"],
    "status_enum": ["success", "failed"],
    "uniqueness": {
      "providers": "providers.name 全局唯一（idx_providers_name_unique）；快速接入不得要求用户逐条输入 name。",
      "models": "models(name, provider_id) 唯一（idx_models_name_provider_unique）；当前实现会在 normalize 阶段按 name 去重，同一渠道下不会写入重复模型名。"
    },
    "snapshot_refresh": {
      "rule": "至少一个 provider 目标创建成功后，只刷新一次 provider snapshot 并发布一次 config:change。",
      "response_note": "当前响应未返回 snapshot_version；如前端需要展示配置生效版本，需要后端扩展 QuickOnboardCreateResult。"
    }
  },
  "observability": {
    "base_prefix": "/api/v1",
    "auth": {
      "admin": "Bearer <jwt>",
      "scoped": "Bearer <jwt> + RBAC PermUsageViewScoped"
    },
    "prompt_visibility": "提示词正文（call_traces.request_body / video_tasks.request_body）按归属与 Key 类型可见：平台 admin 可看全部；其余角色只看得到自己的记录，别人的提示词不下发（request_body 被后端清空，omitempty 不返回）；程序（call_logs.key_type=service / video_tasks.api_key_type=service）Key 发起的调用提示词一律不下发，即便 Key 持有者本人也看不到，admin 仍例外。response_body 与耗时/token/费用等元数据保留。管辖范围（studio/dept）只决定「看得到这条记录」，不决定能否看提示词。前端对不可见的记录隐藏「提示词 / 原始请求 / 请求」Tab 与任务详情「提示词」字段。另：/my/usage/logs/:request_id/trace 由 MyTrace 处理并校验归属，他人 request_id 一律 404（修复原先可凭 request_id 读取他人正文的越权）。",
    "log_row_fields": [
      "request_id", "ts",
      "key_id", "key_name", "key_type",
      "user_id", "user_name", "dept_id", "dept_name", "studio_id", "studio_name",
      "model", "routed_model", "group_name", "provider",
      "prompt_tokens", "cached_tokens", "cache_write_tokens",
      "completion_tokens", "reasoning_tokens", "total_tokens",
      "status", "duration_ms", "first_token_ms",
      "est_cost_usd", "input_cost_usd", "output_cost_usd", "cache_read_cost_usd",
      "input_price_snapshot", "output_price_snapshot",
      "stage_auth_ms", "stage_route_ms", "stage_upstream_ms", "stage_ttfb_ms",
      "stream", "failover_used", "usage_missing", "reasoning_effort",
      "budget_tier_id", "budget_tier_name_snapshot", "budget_tier_accounting_eligible",
      "budget_tier_constraints_snapshot",
      "budget_block_code", "budget_block_dimension", "budget_block_scope_type",
      "budget_block_scope_id", "budget_block_period_type",
      "quota_gate", "quota_layer", "quota_limit",
      "ip_address", "user_agent"
    ],
    "log_row_field_notes": {
      "quota_gate": "concurrency | rpm；仅被配额闸门拒绝的请求（429）有值，其余为空。取值来自本次判定的 QuotaViolation，非事后推断",
      "quota_layer": "subject | group | model | default；该次判定生效的配额层级",
      "quota_limit": "int | null；该次判定实际生效的限额值。null=非配额拒绝；0=该层未设限/已关闭"
    },
    "key_type_enum": ["personal", "service"],
  "routes": [
      {
        "method": "GET",
        "path": "/api/v1/usage/logs",
        "auth": "admin",
        "handler": "UsageHandler.Logs",
        "query_params_optional": [
          "from", "to", "page", "page_size",
          "key_id", "key_name", "key_type",
          "user_name", "dept_name", "studio_id",
          "model_name", "group_name", "provider", "status"
        ],
        "query_param_notes": {
          "key_type": "personal | service；筛选 Key 类型（call_logs 写入时快照）",
          "status": "success | error"
        },
        "response_status": [200, 401, 500],
        "response_fields": ["rows", "total", "page", "page_size"],
        "response_row_fields_ref": "log_row_fields"
      },
      {
        "method": "GET",
        "path": "/api/v1/usage-logs",
        "auth": "admin",
        "handler": "UsageHandler.Logs",
        "$comment": "与 /usage/logs 等价别名"
      },
      {
        "method": "GET",
        "path": "/api/v1/my/usage/logs",
        "auth": "jwt",
        "handler": "UsageHandler.MyLogs",
        "query_params_optional": [
          "from", "to", "page", "page_size",
          "key_id", "key_name", "key_type",
          "user_name", "model_name", "group_name", "status"
        ],
        "response_fields": ["rows", "total", "page", "page_size"],
        "response_row_fields_ref": "log_row_fields"
      },
      {
        "method": "GET",
        "path": "/api/v1/usage/scoped/logs",
        "auth": "scoped",
        "handler": "UsageHandler.ScopedLogs",
        "query_params_optional": [
          "start", "end", "page", "page_size",
          "user_id", "user_name", "dept_id", "studio_id",
          "model_name", "status", "key_type"
        ],
        "response_fields": ["rows", "total", "page", "page_size"],
        "response_row_fields_ref": "log_row_fields"
      }
    ]
  },
  "quota": {
    "base_prefix": "/api/v1",
    "auth": {
      "admin": "Bearer <jwt>",
      "jwt": "Bearer <jwt>"
    },
    "quota_effective_fields": [
      "rpm", "max_concurrency", "source", "subject_type", "subject_id",
      "default_rpm", "default_max_concurrency",
      "configured_rpm", "configured_max_concurrency",
      "rpm_source", "max_concurrency_source"
    ],
    "source_enum": ["default_user", "default_service_key", "override", "unset"],
    "routes": [
      {
        "method": "PATCH",
        "path": "/api/v1/users/:id/quota",
        "auth": "admin (quota:user:set)",
        "handler": "QuotaHandler.SetUserQuota",
        "request_body": {
          "rpm": "int | null (0=unlimited, null=inherit default)",
          "max_concurrency": "int | null (0=unlimited, null=inherit default)"
        },
        "response_status": [200, 400, 500],
        "response_fields": ["code", "message"]
      },
      {
        "method": "GET",
        "path": "/api/v1/users/:id/quota",
        "auth": "admin (quota:user:set)",
        "handler": "QuotaHandler.GetUserQuota",
        "response_status": [200, 404],
        "response_fields_ref": "quota_effective_fields"
      },
      {
        "method": "PATCH",
        "path": "/api/v1/keys/:id/quota",
        "auth": "admin (quota:service_key:set)",
        "handler": "QuotaHandler.SetServiceKeyQuota",
        "request_body": {
          "rpm": "int | null",
          "max_concurrency": "int | null"
        },
        "response_status": [200, 400, 500],
        "response_fields": ["code", "message"]
      },
      {
        "method": "GET",
        "path": "/api/v1/keys/:id/quota",
        "auth": "admin (quota:service_key:set)",
        "handler": "QuotaHandler.GetServiceKeyQuota",
        "response_status": [200, 404],
        "response_fields_ref": "quota_effective_fields"
      },
      {
        "method": "PATCH",
        "path": "/api/v1/groups/:id/quota",
        "auth": "admin (quota:group:set)",
        "handler": "QuotaHandler.SetGroupQuota",
        "request_body": {
          "rpm": "int | null",
          "max_concurrency": "int | null"
        },
        "response_status": [200, 400, 500],
        "response_fields": ["code", "message"]
      },
      {
        "method": "GET",
        "path": "/api/v1/groups/:id/quota",
        "auth": "admin (quota:group:set)",
        "handler": "QuotaHandler.GetGroupQuota",
        "response_status": [200, 404],
        "response_fields_ref": "quota_effective_fields"
      },
      {
        "method": "PATCH",
        "path": "/api/v1/models/:id/quota",
        "auth": "admin (quota:model:set)",
        "handler": "QuotaHandler.SetModelQuota",
        "request_body": {
          "rpm": "int | null",
          "max_concurrency": "int | null"
        },
        "response_status": [200, 400, 500],
        "response_fields": ["code", "message"]
      },
      {
        "method": "GET",
        "path": "/api/v1/models/:id/quota",
        "auth": "admin (quota:model:set)",
        "handler": "QuotaHandler.GetModelQuota",
        "response_status": [200, 404],
        "response_fields_ref": "quota_effective_fields"
      },
      {
        "method": "GET",
        "path": "/api/v1/me/quota",
        "auth": "jwt",
        "handler": "QuotaHandler.GetMyQuota",
        "response_status": [200, 401, 500],
        "response_fields_ref": "quota_effective_fields"
      },
      {
        "method": "POST",
        "path": "/api/v1/quota/exemptions",
        "auth": "admin (quota:default:set)",
        "handler": "QuotaExemptionHandler.Create",
        "request_body": {
          "subject_type": "user | service_key",
          "subject_id": "string (required)",
          "reason": "string (optional)",
          "expires_at": "RFC3339 timestamp (required)"
        },
        "response_status": [201, 400],
        "response_fields": ["code", "data"]
      },
      {
        "method": "DELETE",
        "path": "/api/v1/quota/exemptions/:id",
        "auth": "admin (quota:default:set)",
        "handler": "QuotaExemptionHandler.Revoke",
        "response_status": [200, 404],
        "response_fields": ["code", "message"]
      },
      {
        "method": "GET",
        "path": "/api/v1/quota/exemptions",
        "auth": "admin (quota:view:scoped)",
        "handler": "QuotaExemptionHandler.List",
        "response_status": [200, 500],
        "response_fields": ["code", "data"]
      }
    ]
  },
  "model_tier_budget": {
    "base_prefix": "/api/v1",
    "money_format": "decimal string (scale=6)",
    "legacy_expansion_money_format": {
      "current_amount": "JSON number (legacy)",
      "requested_amount": "JSON number (legacy)"
    },
    "period_type_enum": ["daily", "weekly", "monthly"],
    "dimension_type_enum": ["total", "tier"],
    "duration_type_enum": ["permanent", "current_period"],
    "gateway_402_error_codes": [
      "budget_exceeded",
      "tier_budget_exceeded"
    ],
    "budget_period": {
      "timezone": "Asia/Shanghai",
      "week_start": "monday",
      "resolver_signature": "Resolve(now, periodType, config) -> (Period, error)"
    },
    "verify_key_budget_scope": {
      "legacy_total_number_fields": ["amount_usd", "daily_amount_usd", "weekly_amount_usd"],
      "tier_limit_decimal_string_fields": ["base_limit_usd", "effective_limit_usd"],
      "effective_limit_rule": "max(base_limit, active_temporary_override_target)"
    },
    "lifecycle_executor": {
      "name": "BudgetLifecycleExecutor",
      "dimensions": ["total", "tier"],
      "records": ["schedule", "temporary_override"],
      "transaction_rule": "one record per transaction; mark failed in a fresh transaction",
      "observer": {
        "name": "BudgetLifecycleObserver",
        "methods": ["OnOverrideExpired", "OnScheduleApplied", "OnScheduleFailed"]
      }
    },
    "snapshot_event": {
      "type": "budget_tier_snapshot_updated",
      "resource_type": "budget_tier_snapshot",
      "json_fields": ["type", "resource_type", "resource_id", "snapshot_version", "timestamp"]
    },
    "call_log_block_fields": {
      "budget_block_code": {"go_type": "*string", "max_length": 64},
      "budget_block_dimension": {"go_type": "*string", "max_length": 8},
      "budget_block_scope_type": {"go_type": "*string", "max_length": 32},
      "budget_block_scope_id": {"go_type": "*string", "max_length": 128},
      "budget_block_period_type": {"go_type": "*string", "max_length": 8}
    },
    "snapshot_flags": [
      "master_enabled",
      "accounting_enabled",
      "positive_enforcement_enabled",
      "zero_block_enabled",
      "shadow_enabled",
      "v2_total_enforcement_enabled",
      "legacy_total_write_enabled"
    ],
    "model_tier_fields": ["id", "name", "description", "color", "sort_order", "enabled", "archived_at", "created_at", "updated_at"],
    "tier_limit_fields": ["id", "budget_allocation_id", "model_tier_id", "model_tier_name", "period_type", "base_limit_usd", "temporary_target_usd", "effective_limit_usd", "source_summary", "enabled", "effective_at", "override_expires_at", "pending_schedule"],
    "my_budget_tiers_fields": ["source_summary", "effective_total", "budget_chain", "tier_limits", "data_updated_at", "stale"],
    "my_budget_source_modes": ["personal", "shared", "mixed"],
    "my_budget_tier_period_statuses": ["tier_disabled", "limit_disabled", "unset", "blocked", "exhausted", "available", "restricted"],
    "my_budget_forbidden_aliases": ["source_mode", "tiers", "data_as_of"],
    "batch_preview_item_status": ["valid", "forbidden", "invalid"],
    "batch_apply_item_status": ["applied", "failed", "skipped"],
    "batch_apply_error_codes": ["BUDGET_ALLOCATION_NOT_FOUND", "ORG_FORBIDDEN", "MODEL_TIER_NOT_FOUND", "MODEL_TIER_DISABLED", "INVALID_BUDGET_PERIOD", "PENDING_BUDGET_SCHEDULE_EXISTS", "BUDGET_PREVIEW_STALE", "BUDGET_CONVERSION_UNSUPPORTED", "BUDGET_CONFIG_SYNC_PENDING", "BUDGET_TIER_LIMIT_NOT_FOUND", "INTERNAL_ERROR"],
    "batch_operations": ["set_fixed", "adjust_percent", "clear"],
    "batch_adjust_directions": ["increase", "decrease"],
    "batch_item_fields": ["item_id", "allocation_id", "scope_type", "scope_id", "model_tier_id", "period_type", "direction", "value"],
    "batch_preview_item_fields": ["item_id", "old_limit_usd", "new_limit_usd", "delta_usd", "status", "error_code", "over_allocation_ratio", "converts_shared_member_to_independent"],
    "batch_apply_fields": ["preview_token", "confirm_item_ids"],
    "tier_usage_cost_fields": ["reported_cost_usd", "accounting_cost_usd"],
    "internal_budget_alert_request_fields": ["scope_type", "scope_id", "period_type", "dimension_type", "model_tier_id"],
