  "model_tier_budget_p2": {
    "money_format": "^-?[0-9]+\\.[0-9]{6}$",
    "legacy_number_fields": ["current_amount", "requested_amount"],
    "decimal_string_fields": ["current_amount_snapshot", "used_amount_snapshot", "target_amount_usd"],
    "risk_block_source_fields": [
      "budget_block_code", "budget_block_dimension", "budget_block_scope_type",
      "budget_block_scope_id", "budget_block_period_type"
    ],
    "expansion_status_enum": ["pending", "precheck_required", "pending_reconfirmation", "approved", "rejected", "cancelled", "expired"],
    "routes": [
      {"method": "POST", "path": "/api/v1/expansion-requests", "response_status": [201, 400, 401, 409, 422]},
      {"method": "GET", "path": "/api/v1/expansion-requests", "response_status": [200, 401]},
      {"method": "GET", "path": "/api/v1/expansion-requests/pending", "response_status": [200, 401, 403]},
      {"method": "GET", "path": "/api/v1/expansion-requests/:id", "response_status": [200, 401, 403, 404]},
      {"method": "PATCH", "path": "/api/v1/expansion-requests/:id", "response_status": [200, 400, 401, 403, 404, 409]},
      {"method": "GET", "path": "/api/v1/expansion-requests/:id/steps", "response_status": [200, 401, 403, 404]},
      {
        "method": "POST",
        "path": "/api/v1/expansion-requests/precheck",
        "response_status": [200, 400, 403, 409, 503],
        "response_fields": [
          "can_submit", "can_notify_owner", "current_limit_usd", "current_used_usd",
          "target_amount_usd", "increase_usd", "precheck_version", "data_as_of",
          "stale", "parent_constraints", "affected_groups", "visible_scopes"
        ]
      },
      {"method": "POST", "path": "/api/v1/expansion-requests/:id/reprecheck", "response_status": [200, 400, 401, 403, 404, 409, 503]},
      {"method": "POST", "path": "/api/v1/expansion-requests/:id/decision", "response_status": [200, 400, 401, 403, 404, 409, 503]},
      {
        "method": "POST",
        "path": "/api/v1/expansion-requests/batch-decision",
        "request_fields": ["decisions[].id", "decisions[].action", "decisions[].comment", "decisions[].precheck_version"],
        "response_status": [200, 400, 401, 403],
        "response_fields": ["results"]
      },
      {"method": "POST", "path": "/api/v1/expansion-requests/notify-owner", "response_status": [200, 400, 401, 403, 503]},
      {
        "method": "PUT",
        "path": "/api/v1/budgets",
        "request_fields": ["scope_type", "scope_id", "period_type", "target_limit_usd", "effective_mode", "reason", "preview_only", "preview_version", "confirm_zero_block", "confirm_below_used", "confirm_replace_schedule"],
        "response_status": [200, 400, 401, 403, 409, 422, 503],
        "response_fields": ["before_limit_usd", "after_limit_usd", "current_used_usd", "affected_members", "affected_groups", "data_as_of", "stale", "below_used", "zero_block", "replaces_pending_schedule", "preview_version"]
      },
      {"method": "GET", "path": "/api/v1/budget/risk-events", "response_status": [200, 400, 403, 503], "response_fields": ["items", "total", "data_as_of", "stale"]},
      {"method": "GET", "path": "/api/v1/budget/risk-events/summary", "response_status": [200, 400, 403, 503], "response_fields": ["total", "warning", "critical", "by_type", "blocked_requests_total", "data_as_of", "stale"]},
      {
        "method": "GET",
        "path": "/api/v1/my/budget/tiers",
        "response_status": [200, 401, 503],
        "response_fields": ["source_summary", "effective_total", "budget_chain", "tier_limits", "data_updated_at", "stale"]
      }
    ]
  },
  "organization_roles": {
    "base_prefix": "/api/v1/org",
    "auth": "Bearer <jwt> + org:role:list",
    "purpose": "在当前操作者可见范围内检索和分页展示管理角色授权，不泄露范围外角色或统计。",
    "routes": {
      "GET /all-roles": {
        "handler": "OrgHandler.ListAllRoles",
        "query_params_optional": ["keyword", "role", "page", "page_size"],
        "response_status": [200, 401, 403, 500],
        "response_fields": ["roles", "total", "page", "page_size", "role_counts"],
        "response_row_fields": ["id", "user_id", "user_name", "email", "dept_name", "role", "scope_type", "scope_id", "granted_by", "created_at"],
        "role_counts_fields": ["admin", "studio_admin", "dept_admin"]
      }
    },
    "semantics": {
      "keyword": "匹配人员姓名、邮箱、所在部门、角色或管辖范围 ID；搜索在服务端、授权范围过滤后执行。",
      "role": "可选值 admin | studio_admin | dept_admin；未传时返回所有可见管理角色。",
      "pagination": "page 默认为 1，page_size 默认为 20，最大 100；total 是应用授权范围和筛选后的总数。",
      "role_counts": "统计当前操作者完整可见范围内的角色数，不随 keyword 或 role 筛选变化。"
    }
  },
  "batch_register_models": {
    "base_prefix": "/api/v1",
    "auth": "admin Bearer <jwt>",
    "purpose": "注册模型时多选渠道，将同一模型配置批量挂到多个渠道；部分成功并返回逐渠道结果。",
    "routes": {
      "POST /models/batch": {
        "handler": "ModelHandler.BatchCreateModels",
        "success_status": 200,
        "error_statuses": {
          "400": ["bad_request"],
          "401": ["unauthorized"],
          "500": ["internal_error"]
        },
        "request_body_fields": [
          "name", "provider_ids", "model_type",
          "upstream_model_id", "description",
          "context_length", "max_output_tokens",
          "input_price", "output_price", "cache_read_price", "cache_write_price",
          "price_mode", "weight",
          "video_supported_resolutions", "video_supported_aspect_ratios",
          "video_min_duration_seconds", "video_max_duration_seconds", "video_supported_actions"
        ],
        "required_fields": ["name", "provider_ids", "model_type"],
        "response_fields": ["success_count", "skip_count", "fail_count", "results"]
      },
      "POST /models/batch-from-catalog": {
        "handler": "ModelHandler.BatchCreateModelsFromCatalog",
        "success_status": 200,
        "error_statuses": {
          "400": ["bad_request"],
          "401": ["unauthorized"],
          "404": ["catalog_not_found"],
          "500": ["internal_error"]
        },
        "request_body_fields": ["catalog_id", "provider_ids", "name"],
        "required_fields": ["catalog_id", "provider_ids", "name"],
        "response_fields": ["success_count", "skip_count", "fail_count", "results"]
      }
    },
    "result_item_fields": ["provider_id", "status", "model_id", "reason"],
    "status_enum": ["created", "skipped", "failed"],
    "semantics": {
      "partial_success": "单渠道失败/已存在不阻塞其余渠道；HTTP 200 返回汇总（除非整请求非法或 catalog 不存在）。",
      "skipped": "同名模型在该渠道已存在 → status=skipped, reason=model already exists",
      "provider_ids": "必填数组，至少 1 个 UUID；服务端去重保序",
      "from_catalog": "catalog 不存在时整请求 404 catalog_not_found，不创建任何模型"
    }
  }
}
