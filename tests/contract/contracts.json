      {
        "method": "POST",
        "path": "/api/v1/models/:id/bind-catalog",
        "auth": "admin",
        "handler": "ModelHandler.BindCatalog",
        "input_struct": "inline {CatalogID uuid; ResetFields bool}",
        "request_fields_required": ["catalog_id"],
