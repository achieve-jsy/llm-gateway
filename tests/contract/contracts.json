        "request_field_constraints": {
          "catalog_id": "required,uuid",
          "reset_fields": "boolean (default false)"
        },
        "$comment_semantics": "CAT-2: 把 model 关联到 catalog 条目；catalog 已绑定时变成换绑。reset_fields=true 时把 InputPrice/OutputPrice/ContextLength/MaxOutputTokens/UpstreamModelID 重置为新 catalog 当前值；标志位 ctx_overridden/max_output_overridden 始终重置为 false。同 catalog 且 reset_fields=false 时报 already_bound_to_same（幂等保护）。",
        "response_status": [200, 400, 401, 404, 500],
        "response_envelope": "success_single",
        "response_item_fields": [
          "id", "name", "provider_id", "model_type", "enabled",
          "upstream_model_id", "description", "context_length",
          "max_output_tokens", "input_price", "output_price", "weight",
          "catalog_id", "ctx_overridden", "max_output_overridden", "catalog",
          "created_at", "updated_at"
        ],
        "error_codes": {
          "400": "invalid_request/bad_request OR invalid_request/already_bound_to_same",
          "404": "not_found/model_not_found OR not_found/catalog_not_found",
          "500": "internal_error/internal_error"
        }
      },
