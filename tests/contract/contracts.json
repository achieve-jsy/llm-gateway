{
  "$comment": "Hand-curated FE↔BE contract table extracted by Team I. Each entry captures the BE-defined contract; FE clients in web/src/services/* must adhere to it.",
  "control_plane": {
    "base_prefix": "/api/v1",
    "internal_prefix": "/internal/v1",
    "auth": {
      "admin": "Bearer <jwt> (Authorization header)",
      "internal": "X-Internal-Token header"
    },
    "response_envelope": {
      "success_single": "{ data: <T> }",
      "success_list": "{ data: <T[]>, total: number, page: number }",
      "success_message": "{ message: string }",
      "error": "{ error: { type: string, message: string, code: string } }"
    },
    "$comment_error_codes": "全量机器可读 code 表（FE 与 BE 同步源；FE 在 web/src/services/http.ts::ERROR_MESSAGES 维护对应文案）。",
    "error_codes_canonical": {
      "bad_request":            { "http": 400, "type": "invalid_request", "scene": "通用参数校验失败" },
      "invalid_tag_id":         { "http": 400, "type": "invalid_request", "scene": "tag_ids 中存在非 UUID" },
      "invalid_model_id":       { "http": 400, "type": "invalid_request", "scene": "批量接口 model_ids 中存在非 UUID" },
      "model_provider_invalid": { "http": 400, "type": "invalid_request", "scene": "创建/更新 Model 时 provider 不存在或已禁用" },
      "sync_not_supported":     { "http": 400, "type": "invalid_request", "scene": "Provider 适配器不支持模型同步" },
      "provider_disabled":      { "http": 400, "type": "invalid_request", "scene": "在已禁用的 Provider 上触发同步" },
      "provider_not_found":     { "http": 404, "type": "not_found",       "scene": "Provider 不存在" },
      "model_not_found":        { "http": 404, "type": "not_found",       "scene": "Model 不存在" },
      "provider_name_conflict": { "http": 409, "type": "conflict",        "scene": "Provider 名称重复" },
      "model_name_conflict":    { "http": 409, "type": "conflict",        "scene": "Model 名称重复" },
      "provider_has_models":    { "http": 409, "type": "conflict",        "scene": "删除 Provider 时仍有关联 Model" },
      "upstream_error":         { "http": 502, "type": "upstream_error",  "scene": "上游 vendor API 异常" },
      "internal_error":         { "http": 500, "type": "internal_error",  "scene": "未知内部错误（兜底）" }
    },
    "routes": [
      {
        "method": "GET",
        "path": "/healthz",
        "auth": "none",
        "handler": "inline",
        "request_fields_required": [],
        "request_fields_optional": [],
        "response_status": [200],
        "response_fields": ["status"]
      },
      {
        "method": "GET",
        "path": "/api/v1/provider-definitions",
        "auth": "admin",
        "handler": "DefinitionHandler.ListDefinitions",
        "request_fields_required": [],
        "request_fields_optional": [],
        "response_status": [200, 401, 500],
        "response_envelope": "success_single",
        "response_item_fields": [
          "id", "display_name", "adapter", "base_url",
          "credential_schema", "vendor_options", "description",
          "icon_url", "doc_url", "default_models", "builtin", "enabled",
          "created_at", "updated_at"
        ]
      },
      {
        "method": "GET",
        "path": "/api/v1/provider-definitions/:id",
        "auth": "admin",
        "handler": "DefinitionHandler.GetDefinition",
        "request_fields_required": [],
        "request_fields_optional": [],
        "response_status": [200, 401, 404],
        "response_envelope": "success_single"
      },
      {
        "method": "POST",
        "path": "/api/v1/providers",
        "auth": "admin",
        "handler": "ProviderHandler.CreateProvider",
        "input_struct": "service.CreateProviderInput",
        "request_fields_required": ["name", "definition_id", "endpoint", "credentials"],
        "request_fields_optional": [
          "type", "weight", "priority", "test_model", "remark",
          "max_retries", "timeout", "tag"
        ],
        "request_fields_ignored_by_backend": [],
        "request_field_constraints": {
          "weight": "omitempty,min=0,max=9999",
          "priority": "omitempty,min=0,max=9999",
          "max_retries": "omitempty,min=0,max=10",
          "timeout": "omitempty,min=1,max=300",
          "test_model": "omitempty,max=200",
          "remark": "omitempty,max=500",
          "tag": "omitempty,max=100"
        },
        "response_status": [201, 400, 401, 409, 500],
        "response_envelope": "success_single",
        "response_item_fields": [
          "id", "name", "definition_id", "type", "endpoint", "enabled",
          "weight", "priority", "status", "test_model", "response_time",
          "balance", "remark", "max_retries", "timeout", "tag",
          "created_at", "updated_at"
        ],
        "error_codes": {
          "400": "invalid_request/bad_request",
          "409": "conflict/provider_name_conflict",
          "500": "internal_error/internal_error"
        }
      },
      {
        "method": "GET",
        "path": "/api/v1/providers",
        "auth": "admin",
        "handler": "ProviderHandler.ListProviders",
        "request_fields_required": [],
        "request_fields_optional": [],
        "query_params": ["page", "page_size"],
        "response_status": [200, 401, 500],
        "response_envelope": "success_list",
        "response_item_fields": [
          "id", "name", "definition_id", "type", "endpoint",
          "credentials", "enabled", "weight", "priority", "status",
          "test_model", "response_time", "balance", "remark",
          "max_retries", "timeout", "tag", "created_at", "updated_at"
        ]
      },
      {
        "method": "GET",
        "path": "/api/v1/providers/:id",
        "auth": "admin",
        "handler": "ProviderHandler.GetProvider",
        "request_fields_required": [],
        "request_fields_optional": [],
        "response_status": [200, 400, 401, 404, 500],
        "response_envelope": "success_single"
      },
      {
        "method": "PUT",
        "path": "/api/v1/providers/:id",
        "auth": "admin",
        "handler": "ProviderHandler.UpdateProvider",
        "input_struct": "service.UpdateProviderInput",
        "request_fields_required": [],
        "request_fields_optional": [
          "name", "definition_id", "type", "endpoint", "credentials",
          "weight", "priority", "test_model", "remark",
          "max_retries", "timeout", "tag"
        ],
        "request_fields_ignored_by_backend": [],
        "$comment_pointer_semantics": "标量字段（test_model/remark/tag）使用 *string，区分 '未传' 与 '主动清空'；数值字段使用 *int，区分 '未传' 与 '主动设为 0'",
        "response_status": [200, 400, 401, 404, 409, 500],
        "response_envelope": "success_single",
        "error_codes": {
          "400": "invalid_request/bad_request",
          "404": "not_found/provider_not_found",
          "409": "conflict/provider_name_conflict",
          "500": "internal_error/internal_error"
        }
      },
      {
        "method": "PATCH",
        "path": "/api/v1/providers/:id/status",
        "auth": "admin",
        "handler": "ProviderHandler.ToggleProviderStatus",
        "input_struct": "inline {Enabled bool}",
        "request_fields_required": ["enabled"],
        "request_fields_optional": [],
        "response_status": [200, 400, 401, 404, 500],
        "response_envelope": "success_single",
        "$comment_response_change": "S1-6: BE 返回完整 ProviderResponse；FE service.toggleProviderStatus 类型签名由 Promise<void> 改为 Promise<Provider>，调用方使用返回对象更新本地状态而非二次拉取列表。",
        "response_item_fields": [
          "id", "name", "definition_id", "type", "endpoint", "enabled",
          "weight", "priority", "status", "test_model", "response_time",
          "balance", "remark", "max_retries", "timeout", "tag",
          "created_at", "updated_at"
        ],
        "error_codes": {
          "404": "not_found/provider_not_found",
          "500": "internal_error/internal_error"
        }
      },
      {
        "method": "DELETE",
        "path": "/api/v1/providers/:id",
        "auth": "admin",
        "handler": "ProviderHandler.DeleteProvider",
        "request_fields_required": [],
        "request_fields_optional": [],
        "response_status": [200, 400, 401, 404, 409, 500],
        "response_envelope": "success_message",
        "error_codes": {
          "404": "not_found/provider_not_found",
          "409": "conflict/provider_has_models",
          "500": "internal_error/internal_error"
        }
      },
      {
        "method": "POST",
        "path": "/api/v1/providers/:id/test",
        "auth": "admin",
        "handler": "TestHandler.TestProvider",
        "request_fields_required": [],
        "request_fields_optional": [],
        "response_status": [200, 400, 401, 404, 500],
        "response_envelope": "success_single",
        "$comment_response_extension": "S1-3: 当请求 ?with_chat_test=true 时，响应在原有 5 字段之外追加 chat_success / chat_response_time / chat_model / chat_error 4 字段，FE TestProviderResult 类型已同步。",
        "response_item_fields": [
          "success", "response_time", "status_code", "model_count", "error",
          "chat_success", "chat_response_time", "chat_model", "chat_error"
        ],
        "query_params": ["with_chat_test"]
      },
      {
        "method": "POST",
        "path": "/api/v1/providers/:id/sync-models",
        "auth": "admin",
        "handler": "SyncHandler.SyncModels",
        "request_fields_required": [],
        "request_fields_optional": [],
        "response_status": [200, 400, 401, 404, 500, 502],
        "response_envelope": "success_single",
        "$comment_unsupported_field": "P5-2: 200 响应中始终包含 unsupported（默认 false），FE SyncResult 类型可继续读取该字段；400 响应改为 type=invalid_request + code=sync_not_supported（S3-2）。",
        "response_item_fields": [
          "added", "existing", "removed",
          "total_upstream", "total_local", "unsupported"
        ],
        "error_codes": {
          "400": "invalid_request/sync_not_supported OR invalid_request/provider_disabled OR invalid_request/bad_request",
          "404": "not_found/provider_not_found",
          "500": "internal_error/internal_error",
          "502": "upstream_error/upstream_error"
        }
      },
      {
        "method": "POST",
        "path": "/api/v1/providers/:id/sync-models/confirm",
        "auth": "admin",
        "handler": "SyncHandler.ConfirmSync",
        "input_struct": "service.ConfirmSyncInput",
        "request_fields_required": ["models_to_add"],
        "request_fields_optional": [],
        "$comment_disable_removed_removed": "P5-1: 历史 disable_removed 字段为无操作 no-op，已在本次迭代从 ConfirmSyncInput 与 FE 调用中彻底移除。",
        "response_status": [200, 400, 401, 500],
        "response_envelope": "success_single",
        "response_item_fields": ["registered", "skipped", "disabled"],
        "error_codes": {
          "400": "invalid_request/bad_request",
          "500": "internal_error/internal_error"
        }
      },
      {
        "method": "POST",
        "path": "/api/v1/models",
        "auth": "admin",
        "handler": "ModelHandler.CreateModel",
        "input_struct": "service.CreateModelInput",
        "request_fields_required": ["name", "provider_id", "model_type"],
        "request_fields_optional": [
          "upstream_model_id", "description", "context_length",
          "max_output_tokens", "input_price", "output_price", "weight"
        ],
        "request_fields_ignored_by_backend": [],
        "request_field_constraints": {
          "model_type": "oneof=chat embedding",
          "provider_id": "uuid",
          "upstream_model_id": "omitempty,max=200",
          "description": "omitempty,max=500",
          "context_length": "omitempty,min=0,max=10000000",
          "max_output_tokens": "omitempty,min=0,max=10000000",
          "input_price": "omitempty,min=0",
          "output_price": "omitempty,min=0",
          "weight": "omitempty,min=0,max=9999"
        },
        "response_status": [201, 400, 401, 409, 500],
        "response_envelope": "success_single",
        "response_item_fields": [
          "id", "name", "provider_id", "model_type", "enabled",
          "upstream_model_id", "description", "context_length",
          "max_output_tokens", "input_price", "output_price", "weight",
          "created_at", "updated_at"
        ],
        "error_codes": {
          "400": "invalid_request/model_provider_invalid OR invalid_request/bad_request",
          "409": "conflict/model_name_conflict",
          "500": "internal_error/internal_error"
        }
      },
      {
        "method": "GET",
        "path": "/api/v1/models",
        "auth": "admin",
        "handler": "ModelHandler.ListModels",
        "request_fields_required": [],
        "request_fields_optional": [],
        "query_params": ["page", "page_size", "provider_id"],
        "response_status": [200, 400, 401, 500],
        "response_envelope": "success_list"
      },
      {
        "method": "GET",
        "path": "/api/v1/models/check-name",
        "auth": "admin",
        "handler": "ModelHandler.CheckModelName",
        "input_struct": "inline",
        "request_fields_required": [],
        "request_fields_optional": [],
        "query_params": ["name"],
        "query_params_required": ["name"],
        "response_status": [200, 400, 401, 500],
        "response_envelope": "success_single",
        "response_item_fields": ["available"],
        "$comment_route_order": "必须在 /api/v1/models/:id 通配前注册，避免被 UpdateModel/DeleteModel 抢占",
        "error_codes": {
          "400": "invalid_request/bad_request (missing name)"
        }
      },
      {
        "method": "PUT",
        "path": "/api/v1/models/:id",
        "auth": "admin",
        "handler": "ModelHandler.UpdateModel",
        "input_struct": "service.UpdateModelInput",
        "request_fields_required": [],
        "request_fields_optional": [
          "name", "provider_id", "model_type", "enabled",
          "upstream_model_id", "description", "context_length",
          "max_output_tokens", "input_price", "output_price", "weight"
        ],
        "request_fields_ignored_by_backend": [],
        "$comment_pointer_semantics": "标量字段（upstream_model_id/description）使用 *string，可以显式清空；数值/布尔字段使用 *int/*float64/*bool 区分 '未传' 与 '0/false'",
        "response_status": [200, 400, 401, 404, 409, 500],
        "response_envelope": "success_single",
        "error_codes": {
          "400": "invalid_request/model_provider_invalid OR invalid_request/bad_request",
          "404": "not_found/model_not_found",
          "409": "conflict/model_name_conflict",
          "500": "internal_error/internal_error"
        }
      },
      {
        "method": "DELETE",
        "path": "/api/v1/models/:id",
        "auth": "admin",
        "handler": "ModelHandler.DeleteModel",
        "request_fields_required": [],
        "request_fields_optional": [],
        "response_status": [200, 400, 401, 404, 500],
        "response_envelope": "success_message",
        "error_codes": {
          "404": "not_found/model_not_found",
          "500": "internal_error/internal_error"
        }
      },
      {
        "method": "GET",
        "path": "/api/v1/model-tags",
        "auth": "admin",
        "handler": "ModelTagHandler.ListTags",
        "request_fields_required": [],
        "request_fields_optional": [],
        "response_status": [200, 401, 500],
        "response_envelope": "success_single",
        "response_item_fields": [
          "id", "name", "color", "description", "sort_order",
          "created_at", "updated_at"
        ]
      },
      {
        "method": "POST",
        "path": "/api/v1/model-tags",
        "auth": "admin",
        "handler": "ModelTagHandler.CreateTag",
        "input_struct": "inline",
        "request_fields_required": ["name", "color"],
        "request_fields_optional": ["description", "sort_order"],
        "request_field_constraints": {
          "name": "max=50",
          "color": "max=30",
          "description": "max=200"
        },
        "$comment_color_max": "S3-1: color 长度上限由 7 提升到 30 以兼容 rgba(R,G,B,A) 格式（FE 已在 TagDialog.vue 关闭 show-alpha 但 BE 仍兼容长字符串）。",
        "response_status": [201, 400, 401, 409, 500],
        "response_envelope": "success_single",
        "error_codes": {
          "400": "invalid_request/bad_request",
          "500": "internal_error/internal_error"
        }
      },
      {
        "method": "PUT",
        "path": "/api/v1/model-tags/:id",
        "auth": "admin",
        "handler": "ModelTagHandler.UpdateTag",
        "input_struct": "inline",
        "request_fields_required": [],
        "request_fields_optional": ["name", "color", "description", "sort_order"],
        "request_field_constraints": {
          "name": "max=50",
          "color": "max=30",
          "description": "max=200"
        },
        "response_status": [200, 400, 401, 404, 500],
        "response_envelope": "success_single",
        "error_codes": {
          "400": "invalid_request/bad_request",
          "500": "internal_error/internal_error"
        }
      },
      {
        "method": "DELETE",
        "path": "/api/v1/model-tags/:id",
        "auth": "admin",
        "handler": "ModelTagHandler.DeleteTag",
        "request_fields_required": [],
        "request_fields_optional": [],
        "response_status": [200, 400, 401, 500],
        "response_envelope": "success_message"
      },
      {
        "method": "GET",
        "path": "/api/v1/models/:id/tags",
        "auth": "admin",
        "handler": "ModelTagHandler.GetModelTags",
        "request_fields_required": [],
        "request_fields_optional": [],
        "response_status": [200, 400, 401, 500],
        "response_envelope": "success_single"
      },
      {
        "method": "PUT",
        "path": "/api/v1/models/:id/tags",
        "auth": "admin",
        "handler": "ModelTagHandler.SetModelTags",
        "input_struct": "inline",
        "request_fields_required": ["tag_ids"],
        "request_fields_optional": [],
        "response_status": [200, 400, 401, 500],
        "response_envelope": "success_single",
        "$comment_strict_validation": "S1-4: tag_ids 内任何非 UUID 元素立刻返回 400 + invalid_tag_id（不再静默 continue）。",
        "error_codes": {
          "400": "invalid_request/invalid_tag_id OR invalid_request/bad_request",
          "500": "internal_error/internal_error"
        }
      },
      {
        "method": "PUT",
        "path": "/api/v1/models/batch-tags",
        "auth": "admin",
        "handler": "ModelTagHandler.BatchSetModelTags",
        "input_struct": "inline",
        "request_fields_required": ["model_ids", "tag_ids"],
        "request_fields_optional": [],
        "response_status": [200, 400, 401, 500],
        "response_envelope": "success_single",
        "$comment_strict_validation": "S1-4: model_ids / tag_ids 内任何非 UUID 元素立刻返回 400 + invalid_model_id / invalid_tag_id。",
        "error_codes": {
          "400": "invalid_request/invalid_model_id OR invalid_request/invalid_tag_id OR invalid_request/bad_request",
          "500": "internal_error/internal_error"
        }
      },
      {
        "method": "GET",
        "path": "/internal/v1/models/available",
        "auth": "internal",
        "handler": "InternalHandler.ListAvailableModels",
        "request_fields_required": [],
        "request_fields_optional": [],
        "response_status": [200, 403, 500],
        "response_envelope": "success_single"
      }
    ]
  },
  "gateway": {
    "base_prefix": "/v1",
    "auth": {
      "client": "Bearer <api_key> (Authorization header)"
    },
    "routes": [
      {
        "method": "GET",
        "path": "/health",
        "auth": "none",
        "response_status": [200]
      },
      {
        "method": "GET",
        "path": "/ready",
        "auth": "none",
        "response_status": [200]
      },
      {
        "method": "POST",
        "path": "/v1/chat/completions",
        "auth": "client",
        "handler": "ChatHandler.Handle",
        "request_fields_required": ["model", "messages"],
        "request_fields_optional": [
          "stream", "temperature", "top_p", "max_tokens",
          "stop", "n", "presence_penalty", "frequency_penalty"
        ],
        "response_status": [200, 400, 401, 429, 500, 502, 504],
        "error_envelope": "{ error: { type, code, message } }"
      },
      {
        "method": "GET",
        "path": "/v1/models",
        "auth": "client",
        "handler": "ModelsHandler.Handle",
        "request_fields_required": [],
        "request_fields_optional": [],
        "response_status": [200, 401, 500],
        "response_envelope": "{ object: 'list', data: ModelInfo[] }",
        "response_item_fields": ["id", "object", "created", "owned_by"]
      }
    ]
  },
  "frontend_clients": {
    "control-plane.ts": {
      "module": "web/src/services/control-plane.ts",
      "calls": [
        { "fn": "getProviderDefinitions",  "method": "GET",    "url": "/api/v1/provider-definitions" },
        { "fn": "getProviders",            "method": "GET",    "url": "/api/v1/providers",
          "query_params": ["page","page_size"],
          "$comment": "S1-2: 新增 page/page_size 可选分页参数，FE 默认不传，传则直通 BE。" },
        { "fn": "getProvider",             "method": "GET",    "url": "/api/v1/providers/:id" },
        { "fn": "createProvider",          "method": "POST",   "url": "/api/v1/providers",
          "body_fields": ["name","definition_id","endpoint","credentials","weight","priority","test_model","remark","max_retries","timeout","tag","type"] },
        { "fn": "updateProvider",          "method": "PUT",    "url": "/api/v1/providers/:id",
          "body_fields": ["name","definition_id","endpoint","credentials","weight","priority","test_model","remark","max_retries","timeout","tag","type"] },
        { "fn": "deleteProvider",          "method": "DELETE", "url": "/api/v1/providers/:id" },
        { "fn": "toggleProviderStatus",    "method": "PATCH",  "url": "/api/v1/providers/:id/status",
          "body_fields": ["enabled"],
          "returns": "Provider",
          "$comment": "S1-6: 返回完整 Provider，由调用方更新本地状态，避免无谓二次拉取列表。" },
        { "fn": "testProvider",            "method": "POST",   "url": "/api/v1/providers/:id/test",
          "query_params": ["with_chat_test"],
          "$comment": "S1-3: TestProviderResult 类型已扩展 chat_success/chat_response_time/chat_model/chat_error。" },
        { "fn": "getModels",               "method": "GET",    "url": "/api/v1/models",
          "query_params": ["provider_id","page","page_size"],
          "$comment": "S1-2: 新增 page/page_size 可选分页参数。" },
        { "fn": "createModel",             "method": "POST",   "url": "/api/v1/models",
          "body_fields": ["name","provider_id","model_type","upstream_model_id","description","context_length","max_output_tokens","input_price","output_price","weight"] },
        { "fn": "updateModel",             "method": "PUT",    "url": "/api/v1/models/:id",
          "body_fields": ["name","provider_id","model_type","upstream_model_id","description","context_length","max_output_tokens","input_price","output_price","weight"] },
        { "fn": "deleteModel",             "method": "DELETE", "url": "/api/v1/models/:id" },
        { "fn": "checkModelNameUnique",    "method": "GET",    "url": "/api/v1/models/check-name",
          "query_params": ["name"] },
        { "fn": "getModelTags",            "method": "GET",    "url": "/api/v1/model-tags" },
        { "fn": "createModelTag",          "method": "POST",   "url": "/api/v1/model-tags",
          "body_fields": ["name","color","description","sort_order"] },
        { "fn": "updateModelTag",          "method": "PUT",    "url": "/api/v1/model-tags/:id",
          "body_fields": ["name","color","description","sort_order"] },
        { "fn": "deleteModelTag",          "method": "DELETE", "url": "/api/v1/model-tags/:id" },
        { "fn": "getModelTagsForModel",    "method": "GET",    "url": "/api/v1/models/:id/tags" },
        { "fn": "setModelTags",            "method": "PUT",    "url": "/api/v1/models/:id/tags",
          "body_fields": ["tag_ids"] },
        { "fn": "batchSetModelTags",       "method": "PUT",    "url": "/api/v1/models/batch-tags",
          "body_fields": ["model_ids","tag_ids"] },
        { "fn": "syncModels",              "method": "POST",   "url": "/api/v1/providers/:id/sync-models" },
        { "fn": "confirmSync",             "method": "POST",   "url": "/api/v1/providers/:id/sync-models/confirm",
          "body_fields": ["models_to_add"],
          "$comment": "P5-1: 已删除 disable_removed（历史 no-op）。" }
      ]
    },
    "gateway-api.ts": {
      "module": "web/src/services/gateway-api.ts",
      "calls": [
        { "fn": "fetchModels", "method": "GET", "url": "/v1/models" }
      ]
    }
  }
}
