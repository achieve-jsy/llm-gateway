        "query_params": ["source_model_id"],
        "query_params_required": ["source_model_id"],
        "$comment_source_model_id": "完整 source_model_id 通过 query 传递，允许含 '/'（FE 必须 URL-encode）。这样可避免引入额外路径段导致的路由抢占。",
        "response_status": [200, 400, 401, 404, 500],
        "response_envelope": "success_single",
        "response_item_fields": [
          "id", "source", "source_model_id", "display_name", "provider", "mode",
          "context_length", "max_output_tokens",
          "input_price_per_million", "output_price_per_million",
          "cache_read_price", "cache_write_price",
          "supports_function_calling", "supports_vision", "supports_prompt_caching",
          "supports_response_schema", "supports_tool_choice",
          "deprecation_date", "synced_at"
        ],
        "error_codes": {
          "400": "invalid_request/bad_request",
          "404": "not_found/catalog_not_found",
          "500": "internal_error/internal_error"
        }
      },
      {
        "method": "POST",
        "path": "/api/v1/model-catalog/sync",
        "auth": "admin",
        "handler": "CatalogHandler.TriggerSync",
        "input_struct": "inline {Force bool}",
        "request_fields_required": [],
        "request_fields_optional": ["force"],
        "request_field_constraints": {
          "force": "omitempty"
        },
        "$comment_async": "异步触发拉取 litellm 目录。同时只允许一个任务运行；并行触发返回 409 + sync_in_progress。force=true 允许在已有任务时强制重排（实现细节由 Team B 决定，契约只保证语义）。",
        "response_status": [202, 400, 401, 409, 500],
        "response_envelope": "success_single",
        "response_item_fields": ["job_id", "status", "source"],
        "error_codes": {
          "400": "invalid_request/bad_request",
          "409": "conflict/sync_in_progress",
          "500": "internal_error/internal_error"
        }
      },
      {
